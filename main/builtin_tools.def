/*
 * Built-in tool registry.
 *
 * Add a new firmware tool in three steps:
 * 1) Implement the handler in main/tools_*.c with tool_execute_fn signature.
 * 2) Declare the handler in main/tools_handlers.h.
 * 3) Add one TOOL_ENTRY(...) line below.
 */

// GPIO
TOOL_ENTRY("gpio_write",
           "Set an allowed GPIO HIGH or LOW.",
           "{\"type\":\"object\",\"properties\":{\"pin\":{\"type\":\"integer\"},\"state\":{\"type\":\"integer\"}},\"required\":[\"pin\",\"state\"]}",
           tools_gpio_write_handler)
TOOL_ENTRY("gpio_read",
           "Read an allowed GPIO.",
           "{\"type\":\"object\",\"properties\":{\"pin\":{\"type\":\"integer\"}},\"required\":[\"pin\"]}",
           tools_gpio_read_handler)
TOOL_ENTRY("gpio_read_all",
           "Read all allowed GPIO states.",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_gpio_read_all_handler)
TOOL_ENTRY("delay",
           "Wait in milliseconds.",
           "{\"type\":\"object\",\"properties\":{\"milliseconds\":{\"type\":\"integer\"}},\"required\":[\"milliseconds\"]}",
           tools_delay_handler)
TOOL_ENTRY("i2c_scan",
           "Scan an I2C bus for devices.",
           "{\"type\":\"object\",\"properties\":{\"sda_pin\":{\"type\":\"integer\"},\"scl_pin\":{\"type\":\"integer\"},\"frequency_hz\":{\"type\":\"integer\"}},\"required\":[\"sda_pin\",\"scl_pin\"]}",
           tools_i2c_scan_handler)
TOOL_ENTRY("i2c_write",
           "Write hex bytes to an I2C address.",
           "{\"type\":\"object\",\"properties\":{\"sda_pin\":{\"type\":\"integer\"},\"scl_pin\":{\"type\":\"integer\"},\"address\":{\"type\":\"integer\"},\"data_hex\":{\"type\":\"string\"},\"frequency_hz\":{\"type\":\"integer\"}},\"required\":[\"sda_pin\",\"scl_pin\",\"address\",\"data_hex\"]}",
           tools_i2c_write_handler)
TOOL_ENTRY("i2c_read",
           "Read bytes from an I2C address.",
           "{\"type\":\"object\",\"properties\":{\"sda_pin\":{\"type\":\"integer\"},\"scl_pin\":{\"type\":\"integer\"},\"address\":{\"type\":\"integer\"},\"read_length\":{\"type\":\"integer\"},\"frequency_hz\":{\"type\":\"integer\"}},\"required\":[\"sda_pin\",\"scl_pin\",\"address\",\"read_length\"]}",
           tools_i2c_read_handler)
TOOL_ENTRY("i2c_write_read",
           "Write hex bytes, then read from the same I2C address.",
           "{\"type\":\"object\",\"properties\":{\"sda_pin\":{\"type\":\"integer\"},\"scl_pin\":{\"type\":\"integer\"},\"address\":{\"type\":\"integer\"},\"write_hex\":{\"type\":\"string\"},\"read_length\":{\"type\":\"integer\"},\"frequency_hz\":{\"type\":\"integer\"}},\"required\":[\"sda_pin\",\"scl_pin\",\"address\",\"write_hex\",\"read_length\"]}",
           tools_i2c_write_read_handler)
TOOL_ENTRY("dht_read",
           "Read a DHT11 or DHT22 sensor.",
           "{\"type\":\"object\",\"properties\":{\"pin\":{\"type\":\"integer\"},\"model\":{\"type\":\"string\",\"enum\":[\"dht11\",\"dht22\"]},\"retries\":{\"type\":\"integer\"}},\"required\":[\"pin\",\"model\"]}",
           tools_dht_read_handler)

// Memory
TOOL_ENTRY("memory_set",
           "Store a user memory value.",
           "{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"value\":{\"type\":\"string\"}},\"required\":[\"key\",\"value\"]}",
           tools_memory_set_handler)
TOOL_ENTRY("memory_get",
           "Read a user memory value.",
           "{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"}},\"required\":[\"key\"]}",
           tools_memory_get_handler)
TOOL_ENTRY("memory_list",
           "List user memory keys.",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_memory_list_handler)
TOOL_ENTRY("memory_delete",
           "Delete a user memory key.",
           "{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"}},\"required\":[\"key\"]}",
           tools_memory_delete_handler)
TOOL_ENTRY("set_persona",
           "Set the assistant persona when the user explicitly asks.",
           "{\"type\":\"object\",\"properties\":{\"persona\":{\"type\":\"string\",\"enum\":[\"neutral\",\"friendly\",\"technical\",\"witty\"]}},\"required\":[\"persona\"]}",
           tools_set_persona_handler)
TOOL_ENTRY("get_persona",
           "Get the current assistant persona.",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_get_persona_handler)
TOOL_ENTRY("reset_persona",
           "Reset the assistant persona to neutral.",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_reset_persona_handler)

// Cron/Scheduler
TOOL_ENTRY("cron_set",
           "Create a scheduled task.",
           "{\"type\":\"object\",\"properties\":{\"type\":{\"type\":\"string\",\"enum\":[\"periodic\",\"daily\",\"once\"]},\"interval_minutes\":{\"type\":\"integer\"},\"delay_minutes\":{\"type\":\"integer\"},\"hour\":{\"type\":\"integer\"},\"minute\":{\"type\":\"integer\"},\"action\":{\"type\":\"string\"}},\"required\":[\"type\",\"action\"]}",
           tools_cron_set_handler)
TOOL_ENTRY("cron_list",
           "List scheduled tasks.",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_cron_list_handler)
TOOL_ENTRY("cron_delete",
           "Delete a scheduled task.",
           "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\"}},\"required\":[\"id\"]}",
           tools_cron_delete_handler)
TOOL_ENTRY("get_time",
           "Get local device time.",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_get_time_handler)
TOOL_ENTRY("set_timezone",
           "Set the device timezone.",
           "{\"type\":\"object\",\"properties\":{\"timezone\":{\"type\":\"string\"}},\"required\":[\"timezone\"]}",
           tools_set_timezone_handler)
TOOL_ENTRY("get_timezone",
           "Get the device timezone.",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_get_timezone_handler)

// System
TOOL_ENTRY("get_version",
           "Get firmware version.",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_get_version_handler)

// Health
TOOL_ENTRY("get_health",
           "Get device health.",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_get_health_handler)
TOOL_ENTRY("get_diagnostics",
           "Get runtime diagnostics.",
           "{\"type\":\"object\",\"properties\":{\"scope\":{\"type\":\"string\",\"enum\":[\"quick\",\"runtime\",\"memory\",\"rates\",\"time\",\"all\"]},\"verbose\":{\"type\":\"boolean\"}}}",
           tools_get_diagnostics_handler)

// User Tool Management
TOOL_ENTRY("create_tool",
           "Create a user tool.",
           "{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"action\":{\"type\":\"string\"}},\"required\":[\"name\",\"description\",\"action\"]}",
           tools_create_tool_handler)
TOOL_ENTRY("list_user_tools",
           "List user-created tools.",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_list_user_tools_handler)
TOOL_ENTRY("delete_user_tool",
           "Delete a user-created tool.",
           "{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"]}",
           tools_delete_user_tool_handler)
TOOL_ENTRY("battery_status",
           "Read battery voltage, percentage, and USB power status. For T-Display.",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_battery_status_handler)

// Battery (T-Display)
TOOL_ENTRY("battery_raw",
           "Read raw ADC value from battery sensor (GPIO34). Returns integer 0-4095.",
           "{\"type\":\"object\",\"properties\":{}},\"required\":[]}",
           tools_battery_raw_handler)
TOOL_ENTRY("battery_voltage",
           "Read battery voltage in millivolts (mV). Uses calibration if available.",
           "{\"type\":\"object\",\"properties\":{}},\"required\":[]}",
           tools_battery_voltage_handler)
TOOL_ENTRY("battery_percent",
           "Read battery percentage (0-100%). Estimates based on voltage curves.",
           "{\"type\":\"object\",\"properties\":{}},\"required\":[]}",
           tools_battery_percent_handler)

// Display (T-Display)
TOOL_ENTRY("display_text",
           "Display text on T-Display screen at (x,y) coordinates. Color is 16-bit RGB565.",
           "{\"type\":\"object\",\"properties\":{\"x\":{\"type\":\"integer\"},\"y\":{\"type\":\"integer\"},\"text\":{\"type\":\"string\"},\"color\":{\"type\":\"integer\",\"description\":\"RGB565 color (default 0xFFFF white)\"}},\"required\":[\"x\",\"y\",\"text\"]}",
           tools_display_text_handler)
TOOL_ENTRY("display_battery",
           "Display battery icon and percentage on T-Display screen at (x,y).",
           "{\"type\":\"object\",\"properties\":{\"x\":{\"type\":\"integer\"},\"y\":{\"type\":\"integer\"},\"percent\":{\"type\":\"integer\",\"min\":0,\"max\":100},\"charging\":{\"type\":\"boolean\"}},\"required\":[\"x\",\"y\",\"percent\"]}",
           tools_display_battery_handler)
TOOL_ENTRY("test_screen", "Turns screen on, displays test text for 5 seconds, then turns off.", "{}", tools_test_screen_handler)
TOOL_ENTRY("red",
           "Displays the word 'red' in red color at position (5,5).",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_red_handler)

TOOL_ENTRY("set_background_color",
           "Set the display background color (RGB565). This color will be used for subsequent clear_screen operations and as default background for text.",
           "{\"type\":\"object\",\"properties\":{\"color\":{\"type\":\"integer\",\"description\":\"RGB565 color value\"}},\"required\":[\"color\"]}",
           tools_set_background_color_handler)

TOOL_ENTRY("clear_screen",
           "Clear the entire screen to the current background color (or optionally specify a color).",
           "{\"type\":\"object\",\"properties\":{\"color\":{\"type\":\"integer\",\"description\":\"Optional RGB565 color to clear to (if omitted uses current background)\"}},\"required\":[]}",
           tools_clear_screen_handler)

TOOL_ENTRY("screen_on",
           "Turn the T-Display backlight on (GPIO4 high).",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_screen_on_handler)

TOOL_ENTRY("screen_off",
           "Turn the T-Display backlight off (GPIO4 low).",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_screen_off_handler)

TOOL_ENTRY("display_progress_bar",
           "Draw a progress bar on the T-Display screen.",
           "{\"type\":\"object\",\"properties\":{\"x\":{\"type\":\"integer\",\"description\":\"X position\"},\"y\":{\"type\":\"integer\",\"description\":\"Y position\"},\"w\":{\"type\":\"integer\",\"description\":\"Width in pixels\"},\"h\":{\"type\":\"integer\",\"description\":\"Height in pixels\"},\"percent\":{\"type\":\"integer\",\"min\":0,\"max\":100,\"description\":\"Fill percentage 0-100\"},\"color\":{\"type\":\"integer\",\"description\":\"RGB565 fill color (default green 0x07E0)\"}},\"required\":[\"x\",\"y\",\"w\",\"h\",\"percent\"]}",
           tools_display_progress_bar_handler)

TOOL_ENTRY("screen_brightness",
           "Set T-Display backlight brightness using PWM (GPIO4). 0=off, 100=full brightness.",
           "{\"type\":\"object\",\"properties\":{\"percent\":{\"type\":\"integer\",\"min\":0,\"max\":100,\"description\":\"Brightness percentage 0-100\"}},\"required\":[\"percent\"]}",
           tools_screen_brightness_handler)

TOOL_ENTRY("display_rect",
           "Draw a filled or outlined rectangle on the T-Display screen.",
           "{\"type\":\"object\",\"properties\":{\"x\":{\"type\":\"integer\",\"description\":\"X position\"},\"y\":{\"type\":\"integer\",\"description\":\"Y position\"},\"w\":{\"type\":\"integer\",\"description\":\"Width in pixels\"},\"h\":{\"type\":\"integer\",\"description\":\"Height in pixels\"},\"color\":{\"type\":\"integer\",\"description\":\"RGB565 color (default white 0xFFFF)\"},\"fill\":{\"type\":\"boolean\",\"description\":\"Fill rectangle (true) or outline (false)\"}},\"required\":[\"x\",\"y\",\"w\",\"h\"]}",
           tools_display_rect_handler)

TOOL_ENTRY("display_multi_text",
           "Display multiple lines of text on the T-Display screen at once.",
           "{\"type\":\"object\",\"properties\":{\"lines\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"Array of text lines (1-20)\"},\"x\":{\"type\":\"integer\",\"description\":\"X position\"},\"y\":{\"type\":\"integer\",\"description\":\"Y position\"},\"spacing\":{\"type\":\"integer\",\"description\":\"Line spacing in pixels (default 12)\"},\"color\":{\"type\":\"integer\",\"description\":\"RGB565 color (default white 0xFFFF)\"}},\"required\":[\"lines\",\"x\",\"y\"]}",
           tools_display_multi_text_handler)

TOOL_ENTRY("display_line",
           "Draw a line on the T-Display screen using Bresenham's algorithm.",
           "{\"type\":\"object\",\"properties\":{\"x0\":{\"type\":\"integer\",\"description\":\"Start X\"},\"y0\":{\"type\":\"integer\",\"description\":\"Start Y\"},\"x1\":{\"type\":\"integer\",\"description\":\"End X\"},\"y1\":{\"type\":\"integer\",\"description\":\"End Y\"},\"color\":{\"type\":\"integer\",\"description\":\"RGB565 color (default white 0xFFFF)\"}},\"required\":[\"x0\",\"y0\",\"x1\",\"y1\"]}",
           tools_display_line_handler)

TOOL_ENTRY("display_icon",
           "Draw a predefined 8x8 icon on the T-Display screen.",
           "{\"type\":\"object\",\"properties\":{\"x\":{\"type\":\"integer\",\"description\":\"X position\"},\"y\":{\"type\":\"integer\",\"description\":\"Y position\"},\"icon\":{\"type\":\"string\",\"enum\":[\"wifi\",\"battery\",\"check\",\"cross\",\"arrow_up\",\"arrow_down\"],\"description\":\"Icon name\"},\"color\":{\"type\":\"integer\",\"description\":\"RGB565 color (default white 0xFFFF)\"}},\"required\":[\"x\",\"y\",\"icon\"]}",
           tools_display_icon_handler)

TOOL_ENTRY("display_scroll_text",
           "Scroll text horizontally across the T-Display screen.",
           "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"Text to scroll\"},\"y\":{\"type\":\"integer\",\"description\":\"Y position\"},\"speed\":{\"type\":\"integer\",\"description\":\"Scroll speed 1-20 (default 2)\"},\"color\":{\"type\":\"integer\",\"description\":\"RGB565 color (default white)\"}},\"required\":[\"text\",\"y\"]}",
           tools_display_scroll_text_handler)

TOOL_ENTRY("display_circle",
           "Draw a filled or outlined circle on the T-Display screen.",
           "{\"type\":\"object\",\"properties\":{\"cx\":{\"type\":\"integer\",\"description\":\"Center X\"},\"cy\":{\"type\":\"integer\",\"description\":\"Center Y\"},\"r\":{\"type\":\"integer\",\"description\":\"Radius\"},\"color\":{\"type\":\"integer\",\"description\":\"RGB565 color (default white)\"},\"fill\":{\"type\":\"boolean\",\"description\":\"Fill (true) or outline (false)\"}},\"required\":[\"cx\",\"cy\",\"r\"]}",
           tools_display_circle_handler)

TOOL_ENTRY("display_screenshot",
           "Get information about the display framebuffer (for debugging).",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_display_screenshot_handler)

TOOL_ENTRY("display_clock",
           "Start or stop a live clock display on the T-Display screen. Updates every second via a background task (not LLM-dependent).",
           "{\"type\":\"object\",\"properties\":{\"action\":{\"type\":\"string\",\"enum\":[\"start\",\"stop\"],\"description\":\"Start or stop the clock (default: start)\"},\"x\":{\"type\":\"integer\",\"description\":\"X position (default 40)\"},\"y\":{\"type\":\"integer\",\"description\":\"Y position (default 5)\"},\"color\":{\"type\":\"integer\",\"description\":\"RGB565 color (default white 0xFFFF)\"},\"show_date\":{\"type\":\"boolean\",\"description\":\"Show date + time (default false)\"}}}",
           tools_display_clock_handler)

TOOL_ENTRY("display_text_centered",
           "Display text centered horizontally on the T-Display screen (135x240 pixels). Auto-calculates X position.",
           "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"Text to display\"},\"y\":{\"type\":\"integer\",\"description\":\"Y position in pixels (default 116, center of 240px height)\"},\"color\":{\"type\":\"integer\",\"description\":\"RGB565 color (default white 0xFFFF)\"}},\"required\":[\"text\"]}",
           tools_display_text_centered_handler)

// Sleep and Loop tools
TOOL_ENTRY("sleep_timer",
           "Wait for specified seconds then wake up.",
           "{\"type\":\"object\",\"properties\":{\"seconds\":{\"type\":\"integer\",\"description\":\"Number of seconds to wait\"}},\"required\":[\"seconds\"]}",
           tools_sleep_timer_handler)

TOOL_ENTRY("sleep_gpio",
           "Wake up when GPIO pin changes state.",
           "{\"type\":\"object\",\"properties\":{\"pin\":{\"type\":\"integer\",\"description\":\"GPIO pin number\"},\"state\":{\"type\":\"string\",\"enum\":[\"high\",\"low\"],\"description\":\"Wait for pin to go high or low\"}},\"required\":[\"pin\",\"state\"]}",
           tools_sleep_gpio_handler)

TOOL_ENTRY("power_save",
           "Enter deep sleep to save power. Turns off screen, sets timer wakeup, optionally enables GPIO wakeup.",
           "{\"type\":\"object\",\"properties\":{\"seconds\":{\"type\":\"integer\",\"description\":\"Sleep duration in seconds\"},\"enable_gpio_wakeup\":{\"type\":\"boolean\",\"description\":\"Enable GPIO wakeup\"},\"gpio_num\":{\"type\":\"integer\",\"description\":\"GPIO pin for wakeup (required if enable_gpio_wakeup is true)\"},\"gpio_level\":{\"type\":\"string\",\"enum\":[\"high\",\"low\"],\"description\":\"GPIO edge for wakeup (required if enable_gpio_wakeup is true)\"}},\"required\":[\"seconds\"]}",
           tools_power_save_handler)

TOOL_ENTRY("loop",
           "Repeat a tool execution multiple times.",
           "{\"type\":\"object\",\"properties\":{\"count\":{\"type\":\"integer\",\"description\":\"Number of times to repeat\"},\"start\":{\"type\":\"integer\",\"description\":\"Starting count value\"},\"tool\":{\"type\":\"string\",\"description\":\"Name of the tool to repeat\"},\"args\":{\"type\":\"object\",\"description\":\"Arguments to pass to the tool\"}},\"required\":[\"count\",\"tool\",\"args\"]}",
           tools_loop_handler)

TOOL_ENTRY("switchLLM",
           "Toggle between primary and fallback LLM configurations.",
           "{\"type\":\"object\",\"properties\":{}}",
           tools_switch_llm_handler)
TOOL_ENTRY("get_current_llm", "Get current LLM model", "{}", tools_get_llm_handler)
